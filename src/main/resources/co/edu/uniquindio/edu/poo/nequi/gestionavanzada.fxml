<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="560.0"
            prefWidth="760.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.edu.poo.nequi.viewcontrollers.GestionAvanzadaViewController">

    <children>

        <!-- TITULO -->
        <Text layoutX="20.0"
              layoutY="33.0"
              fill="#4523b5"
              text="NEQUI - Gestion avanzada">
            <font>
                <Font name="System Bold" size="20.0"/>
            </font>
        </Text>

        <Label fx:id="lblCuenta"
               layoutX="20.0"
               layoutY="47.0"
               prefWidth="720.0"
               text="Cliente / Monedero"
               style="-fx-font-size: 12;"/>

        <!-- PESTAÑAS -->
        <TabPane layoutX="17.0"
                 layoutY="77.0"
                 prefWidth="726.0"
                 prefHeight="404.0"
                 tabClosingPolicy="UNAVAILABLE">

            <tabs>

                <!-- PRIMERA PESTAÑA -->
                <Tab text="Programar">

                    <content>

                        <AnchorPane prefWidth="700.0"
                                    prefHeight="365.0">

                            <children>

                                <Label layoutX="20.0"
                                       layoutY="16.0"
                                       text="Operacion:"/>

                                <ComboBox fx:id="cbTipoOperacion"
                                          layoutX="20.0"
                                          layoutY="36.0"
                                          prefWidth="225.0"
                                          onAction="#cambiarTipoEvent"/>

                                <Label layoutX="270.0"
                                       layoutY="16.0"
                                       text="Frecuencia:"/>

                                <ComboBox fx:id="cbFrecuencia"
                                          layoutX="270.0"
                                          layoutY="36.0"
                                          prefWidth="230.0"/>

                                <Label layoutX="20.0"
                                       layoutY="93.0"
                                       text="Fecha de ejecucion:"/>

                                <DatePicker fx:id="dpFecha"
                                            layoutX="20.0"
                                            layoutY="113.0"
                                            prefWidth="225.0"/>

                                <Label layoutX="270.0"
                                       layoutY="93.0"
                                       text="Hora (HH:mm):"/>

                                <TextField fx:id="txtHora"
                                           layoutX="270.0"
                                           layoutY="113.0"
                                           prefWidth="230.0"
                                           promptText="14:30"/>

                                <Label layoutX="20.0"
                                       layoutY="168.0"
                                       text="Monto:"/>

                                <TextField fx:id="txtMonto"
                                           layoutX="20.0"
                                           layoutY="188.0"
                                           prefWidth="225.0"
                                           promptText="500.00"/>

                                <Label layoutX="270.0"
                                       layoutY="168.0"
                                       text="Destino (solo transferencias):"/>

                                <TextField fx:id="txtDestino"
                                           layoutX="270.0"
                                           layoutY="188.0"
                                           prefWidth="230.0"
                                           promptText="Ejemplo: M02"/>

                                <Button layoutX="20.0"
                                        layoutY="254.0"
                                        prefWidth="480.0"
                                        prefHeight="32.0"
                                        onAction="#programarEvent"
                                        text="Guardar programacion"
                                        style="-fx-background-color: #4523b5; -fx-text-fill: white; -fx-font-weight: bold;"/>

                                <Label layoutX="20.0"
                                       layoutY="302.0"
                                       prefWidth="655.0"
                                       wrapText="true"
                                       text="Los depositos van al monedero seleccionado. En transferencias, el monedero seleccionado es el origen."
                                       style="-fx-font-size: 11; -fx-text-fill: #555555;"/>

                            </children>

                        </AnchorPane>

                    </content>

                </Tab>

                <!-- SEGUNDA PESTAÑA -->
                <Tab text="Programaciones">

                    <content>

                        <AnchorPane prefWidth="700.0"
                                    prefHeight="365.0">

                            <children>

                                <Label layoutX="20.0"
                                       layoutY="12.0"
                                       text="Selecciona una programacion:"/>

                                <ListView fx:id="lstProgramaciones"
                                          layoutX="20.0"
                                          layoutY="33.0"
                                          prefWidth="675.0"
                                          prefHeight="150.0"/>

                                <Button layoutX="20.0"
                                        layoutY="195.0"
                                        prefWidth="150.0"
                                        text="Ver detalle"
                                        onAction="#verDetalleProgramacionEvent"/>

                                <Button layoutX="185.0"
                                        layoutY="195.0"
                                        prefWidth="160.0"
                                        text="Cancelar"
                                        onAction="#cancelarEvent"/>

                                <Button layoutX="360.0"
                                        layoutY="195.0"
                                        prefWidth="170.0"
                                        text="Procesar ahora"
                                        onAction="#procesarAhoraEvent"/>

                                <TextArea fx:id="txtDetalleProgramacion"
                                          layoutX="20.0"
                                          layoutY="235.0"
                                          prefWidth="675.0"
                                          prefHeight="108.0"
                                          editable="false"
                                          wrapText="true"/>

                            </children>

                        </AnchorPane>

                    </content>

                </Tab>

                <!-- TERCERA PESTAÑA -->
                <Tab text="Revertir movimientos">

                    <content>

                        <AnchorPane prefWidth="700.0"
                                    prefHeight="365.0">

                            <children>

                                <Label layoutX="20.0"
                                       layoutY="12.0"
                                       text="Selecciona una transaccion del monedero:"/>

                                <ListView fx:id="lstMovimientos"
                                          layoutX="20.0"
                                          layoutY="33.0"
                                          prefWidth="675.0"
                                          prefHeight="150.0"/>

                                <Button layoutX="20.0"
                                        layoutY="195.0"
                                        prefWidth="150.0"
                                        text="Ver detalle"
                                        onAction="#verDetalleMovimientoEvent"/>

                                <Button layoutX="185.0"
                                        layoutY="195.0"
                                        prefWidth="195.0"
                                        text="Revertir seleccionado"
                                        onAction="#revertirEvent"
                                        style="-fx-background-color: #ad3440; -fx-text-fill: white;"/>

                                <TextArea fx:id="txtDetalleMovimiento"
                                          layoutX="20.0"
                                          layoutY="235.0"
                                          prefWidth="675.0"
                                          prefHeight="108.0"
                                          editable="false"
                                          wrapText="true"/>

                            </children>

                        </AnchorPane>

                    </content>

                </Tab>

            </tabs>

        </TabPane>

        <!-- RECORDATORIOS -->
        <Label fx:id="lblRecordatorios"
               layoutX="20.0"
               layoutY="490.0"
               prefWidth="710.0"
               text="Recordatorios: sin operaciones proximas"
               style="-fx-font-size: 11;"/>

        <!-- MENSAJE -->
        <Label fx:id="lblMensaje"
               layoutX="20.0"
               layoutY="528.0"
               prefWidth="490.0"
               text="Gestion avanzada lista"
               style="-fx-font-size: 11;"/>

        <!-- BOTONES -->
        <Button layoutX="532.0"
                layoutY="521.0"
                prefWidth="95.0"
                prefHeight="27.0"
                text="Actualizar"
                onAction="#actualizarEvent"/>

        <Button layoutX="638.0"
                layoutY="521.0"
                prefWidth="102.0"
                prefHeight="27.0"
                text="Volver"
                onAction="#volverEvent"/>

    </children>

</AnchorPane>
